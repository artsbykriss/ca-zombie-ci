pragma solidity 0.8.24;
import "forge-std/Test.sol";
contract ZodiacDelayQueueTest is Test {
    address constant DELAY = 0x0F1D8A73C02F2E44b17aF3e1ac389E7ce0a2E15B;
    address constant AVATAR = 0x36B42d0EE96d66928674E02B005dF2d8D75E68C5;
    address constant PENDING_TO = 0x38869bf66a61cF6bDB996A6aE40D5853Fd43B526;
    function setUp() public {
        vm.createSelectFork(vm.envOr("FORK_RPC_URL", string("https://ethereum-rpc.publicnode.com")));
    }
    function test_pending_queue_liveness() public {
        uint256 n0 = _u(DELAY, 0xc66323e5);
        uint256 q0 = _u(DELAY, 0xde8dd91d);
        emit log_named_uint("txNonce", n0);
        emit log_named_uint("queueNonce", q0);
        _tryExec(hex"", 1);
        _tryExec(hex"", 1);
        _tryExec(hex"", 1);
        emit log_named_uint("txNonce after", _u(DELAY, 0xc66323e5));
        emit log_named_uint("avatar ETH", AVATAR.balance);
    }
    function _tryExec(bytes memory data, uint8 op) internal {
        (bool ok, bytes memory ret) = DELAY.call(abi.encodeWithSelector(0xee072baf, PENDING_TO, uint256(0), data, op));
        emit log_named_string("exec ok", ok ? "TRUE" : "false");
        emit log_named_bytes("exec ret", ret);
    }
    function _u(address t, bytes4 s) internal view returns (uint256 v) {
        (bool ok, bytes memory r) = t.staticcall(abi.encodeWithSelector(s));
        if (ok && r.length >= 32) v = abi.decode(r, (uint256));
    }
}
