// src/base/Protocol.sol

abstract contract Protocol is Ownable {
    // Custom errors to provide more descriptive revert messages.
    error GreaterThanMaxProtocolFeeCommission(uint256 protocolFeeCommission);
    error InvalidRate();

    using SafeERC20 for IERC20;

    uint256 public constant MAX_PROTOCOL_FEE_COMMISSION = 2 * 1e17;

    address public lsdToken;
    uint256 public protocolFeeCommission;
    uint256 public totalProtocolFee;

    function withdrawProtocolFee(address _to) external virtual onlyOwner {
        IERC20(lsdToken).safeTransfer(_to, IERC20(lsdToken).balanceOf(address(this)));
    }

    function setProtocolFeeCommission(uint256 _protocolFeeCommission) external virtual onlyOwner {
        if (_protocolFeeCommission > MAX_PROTOCOL_FEE_COMMISSION) {
            revert GreaterThanMaxProtocolFeeCommission(_protocolFeeCommission);
        }

        protocolFeeCommission = _protocolFeeCommission;
    }

    function _initProtocolParams(address _lsdToken) internal virtual onlyInitializing {
        if (_lsdToken == address(0)) revert AddressNotAllowed();

        lsdToken = _lsdToken;
        protocolFeeCommission = 1e17;
    }

    function _distributeReward(uint256 _totalNewReward, uint256 _rate) internal {
        if (_rate == 0) revert InvalidRate();
        if (_totalNewReward > 0) {
            uint256 lsdTokenProtocolFee = (_totalNewReward * protocolFeeCommission) / _rate;

            if (lsdTokenProtocolFee > 0) {
                totalProtocolFee = totalProtocolFee + lsdTokenProtocolFee;
                // mint lsdToken
                ILsdToken(lsdToken).mint(address(this), lsdTokenProtocolFee);
            }
        }
    }
}

// src/base/Manager.sol

abstract contract Manager is Era, Rate, StakePoolManager, UnstakePoolManager, Protocol {
    uint256 public constant MAX_VALIDATORS_LEN = 30;

    function _initManagerParams(
        address _lsdToken,
        address _poolAddress,
        uint256 _unbondingDuration,
        uint256 _rateChangeLimit,
        uint256 _eraSeconds
    ) internal virtual onlyInitializing {
        _initProtocolParams(_lsdToken);
        _initEraParams(_eraSeconds);
        _initRateParams(_rateChangeLimit);
        _initStakePoolParams(_poolAddress);
        _initUnstakeParams(_unbondingDuration);
    }
}

// src/StakeManager.sol

contract StakeManager is Initializable, Manager, UUPSUpgradeable {
    // Custom errors to provide more descriptive revert messages.
    error PoolNotEmpty();
    error DelegateNotEmpty();
    error PoolNotExist(address poolAddress);
    error ValidatorNotExist();
    error ValidatorDuplicated();
    error ZeroRedelegateAmount();
    error NotEnoughStakeAmount();
    error ZeroUnstakeAmount();
    error ZeroWithdrawAmount();
    error UnstakeTimesExceedLimit();
    error AlreadyWithdrawed();
    error EraNotMatch();
    error ZeroMigrationAmount();
    error ExceedsPendingMigration();
    error ValidatorNotInPool();

    using EnumerableSet for EnumerableSet.AddressSet;
    using EnumerableSet for EnumerableSet.UintSet;

    mapping(address => EnumerableSet.AddressSet) validatorsOf;

    // Tracks ETH undelegated by admin that is in transit (validator unbonding period).
    // Added to pool active accounting so rate stays stable during migration.
    mapping(address => uint256) public pendingMigration;

    // events
    event Stake(address staker, address poolAddress, uint256 tokenAmount, uint256 lsdTokenAmount, string memo);
    event Unstake(
        address staker, address poolAddress, uint256 tokenAmount, uint256 lsdTokenAmount, uint256 unstakeIndex
    );
    event Withdraw(address staker, address poolAddress, uint256 tokenAmount, int256[] unstakeIndexList);
    event ExecuteNewEra(uint256 indexed era, uint256 rate);
    event Delegate(address pool, address[] validators, uint256 amount);
    event Undelegate(address pool, address[] validators, uint256 amount);
    event NewReward(address pool, uint256 amount);
    event AdminForceUndelegate(address pool, address[] validators, uint256 amount);
    event AdminCompleteMigration(address pool, address[] validators, uint256 amount);
    event MigrateValidatorBegin(address indexed pool, address oldValidator, address newValidator, uint256 amount);

    /// @custom:oz-upgrades-unsafe-allow constructor
    constructor() {
        _disableInitializers();
    }

    function initialize(address _lsdToken, address _poolAddress, address[] memory _validators, uint256 _eraSeconds)
        external
        initializer
    {
        _initOwner(msg.sender);
        _initManagerParams(_lsdToken, _poolAddress, 22, 0, _eraSeconds);

        minStakeAmount = 1e15;

        if (_validators.length == 0) {
            revert ValidatorsEmpty();
        }

        for (uint256 i = 0; i < _validators.length; ++i) {
            validatorsOf[_poolAddress].add(_validators[i]);
        }
    }

    function _authorizeUpgrade(address newImplementation) internal override onlyOwner {}

    // ------------ getter ------------

    function version() external view returns (uint8) {
        return _getInitializedVersion();
    }

    function getValidatorsOf(address _poolAddress) public view returns (address[] memory validators) {
        return validatorsOf[_poolAddress].values();
    }

    // ------------ settings ------------

    function rmStakePool(address _poolAddress) external onlyOwner {
        PoolInfo memory poolInfo = poolInfoOf[_poolAddress];
        if (!(poolInfo.active == 0 && poolInfo.bond == 0 && poolInfo.unbond == 0)) revert PoolNotEmpty();

        address[] memory validators = getValidatorsOf(_poolAddress);
        for (uint256 j = 0; j < validators.length; ++j) {
            if (IStakePool(_poolAddress).getDelegated(validators[j]) != 0) revert DelegateNotEmpty();

            validatorsOf[_poolAddress].remove(validators[j]);
        }

        if (!bondedPools.remove(_poolAddress)) revert PoolNotExist(_poolAddress);
    }

    function addValidator(address _poolAddress, address _validator) external onlyOwner {
        if (validatorsOf[_poolAddress].length() >= MAX_VALIDATORS_LEN) revert ValidatorsLenExceedLimit();
        if (!validatorsOf[_poolAddress].add(_validator)) revert ValidatorDuplicated();
    }

    function rmValidator(address _poolAddress, address _validator) external onlyOwner {
        if (IStakePool(_poolAddress).getDelegated(_validator) != 0) revert DelegateNotEmpty();
        if (!validatorsOf[_poolAddress].remove(_validator)) revert ValidatorNotExist();
    }

    // Atomically swap validators in a single transaction:
    //   1. Register newValidator.
    //   2. Force-undelegate everything from oldValidator using getTotalDelegated (which includes
    //      StakePool's pendingBond) so that getDelegated(old) drops to exactly 0 — regardless of
    //      any buffered pendingBond — and rmValidator will succeed.
    //   3. Remove oldValidator.
    //
    // All three steps happen in one tx, so newEra() can never observe both validators in the list
    // at the same time (which would cause user stakes to be split into the exited validator).
    //
    // After this call, pendingMigration[pool] equals the total in-transit amount. Once the
    // validator unbonding period elapses and ETH returns to StakePool, call adminCompleteMigration.
    function migrateValidatorBegin(address _poolAddress, address _oldValidator, address _newValidator)
        external
        onlyOwner
    {
        if (!bondedPools.contains(_poolAddress)) revert PoolNotExist(_poolAddress);
        if (validatorsOf[_poolAddress].length() >= MAX_VALIDATORS_LEN) revert ValidatorsLenExceedLimit();
        if (!validatorsOf[_poolAddress].add(_newValidator)) revert ValidatorDuplicated();

        address[] memory oldValidators = new address[](1);
        oldValidators[0] = _oldValidator;

        // getTotalDelegated = getDelegated(old) + pendingBond.
        // Passing this as the undelegate amount ensures:
        //   undelegateMulti consumes pendingBond first, then undelegates the remainder from the
        //   validator, leaving getDelegated(old) == 0 so rmValidator passes.
        uint256 amount = IStakePool(_poolAddress).getTotalDelegated(oldValidators);
        if (amount > 0) {
            IStakePool(_poolAddress).undelegateMulti(oldValidators, amount);
            pendingMigration[_poolAddress] += amount;
            emit AdminForceUndelegate(_poolAddress, oldValidators, amount);
        }

        if (!validatorsOf[_poolAddress].remove(_oldValidator)) revert ValidatorNotExist();
        emit MigrateValidatorBegin(_poolAddress, _oldValidator, _newValidator, amount);
    }

    // Delegate pending migration ETH (already back at StakePool after unbonding) to new validators.
    // Call this after the validator unbonding period has elapsed and ETH has returned to StakePool.
    function adminCompleteMigration(address _poolAddress, address[] calldata _validators, uint256 _amount)
        external
        onlyOwner
    {
        if (_amount == 0) revert ZeroMigrationAmount();
        if (!bondedPools.contains(_poolAddress)) revert PoolNotExist(_poolAddress);
        if (pendingMigration[_poolAddress] < _amount) revert ExceedsPendingMigration();
        for (uint256 i = 0; i < _validators.length; i++) {
            if (!validatorsOf[_poolAddress].contains(_validators[i])) revert ValidatorNotInPool();
        }

        pendingMigration[_poolAddress] -= _amount;
        IStakePool(_poolAddress).delegateMulti(_validators, _amount);

        emit AdminCompleteMigration(_poolAddress, _validators, _amount);
    }

    // Force undelegate from specific validators (e.g. an exited validator) bypassing the normal
    // bond/unbond flow. The undelegated amount is recorded in pendingMigration so that the rate
    // calculation in newEra() stays stable during the validator unbonding period.
    //
    // After calling this function:
    //   1. getDelegated(_oldValidators) drops to ~0 immediately → rmValidator is now safe to call.
    //   2. pendingMigration[pool] is credited with _amount so newEra() does not treat it as a loss.
    //   3. Once the on-chain unbonding completes, ETH arrives back at the StakePool contract.
    //   4. Admin then calls adminCompleteMigration to delegate that ETH to the new validator.
    //
    // IMPORTANT: pass IStakePool(pool).getTotalDelegated([validator]), NOT getDelegated(validator).
    // getTotalDelegated includes StakePool.pendingBond; using getDelegated when pendingBond > 0
    // will leave residual shares on the validator and cause the subsequent rmValidator to revert.
    //
    // Risk: if net user unstakes during the unbonding window exceed pendingMigration, newEra() may
    // revert. Monitor activity and call adminCompleteMigration as soon as ETH is available.
    function adminForceUndelegate(address _poolAddress, address[] calldata _validators, uint256 _amount)
        external
        onlyOwner
    {
        if (_amount == 0) revert ZeroMigrationAmount();
        if (!bondedPools.contains(_poolAddress)) revert PoolNotExist(_poolAddress);
        for (uint256 i = 0; i < _validators.length; i++) {
            if (!validatorsOf[_poolAddress].contains(_validators[i])) revert ValidatorNotInPool();
        }

        IStakePool(_poolAddress).undelegateMulti(_validators, _amount);
        pendingMigration[_poolAddress] += _amount;

        emit AdminForceUndelegate(_poolAddress, _validators, _amount);
    }

    // ----- staker operation

    function stake(string calldata _memo) external payable {
        stakeWithPool(bondedPools.at(0), _memo);
    }

    function stakeWithReceiver(address _receiver, string calldata _memo) external payable {
        stakeWithPoolReceiver(bondedPools.at(0), _receiver, _memo);
    }

    function unstake(uint256 _lsdTokenAmount) external {
        unstakeWithPool(bondedPools.at(0), _lsdTokenAmount);
    }

    function withdraw() external {
        withdrawWithPool(bondedPools.at(0));
    }

    function stakeWithPool(address _poolAddress, string calldata _memo) public payable {
        stakeWithPoolReceiver(_poolAddress, msg.sender, _memo);
    }

    function stakeWithPoolReceiver(address _poolAddress, address _receiver, string calldata _memo) public payable {
        uint256 stakeAmount = msg.value;

        if (stakeAmount < minStakeAmount) revert NotEnoughStakeAmount();
        if (!bondedPools.contains(_poolAddress)) revert PoolNotExist(_poolAddress);

        uint256 lsdTokenAmount = (stakeAmount * EIGHTEEN_DECIMALS) / rate;

        // update pool
        PoolInfo storage poolInfo = poolInfoOf[_poolAddress];
        poolInfo.bond = poolInfo.bond + stakeAmount;
        poolInfo.active = poolInfo.active + stakeAmount;

        (bool result,) = _poolAddress.call{value: stakeAmount}("");
        if (!result) revert FailedToCall();

        // mint lsdToken
        ILsdToken(lsdToken).mint(_receiver, lsdTokenAmount);

        emit Stake(_receiver, _poolAddress, stakeAmount, lsdTokenAmount, _memo);
    }

    function unstakeWithPool(address _poolAddress, uint256 _lsdTokenAmount) public {
        if (_lsdTokenAmount == 0) revert ZeroUnstakeAmount();
        if (!bondedPools.contains(_poolAddress)) revert PoolNotExist(_poolAddress);
        if (unstakesOfUser[msg.sender].length() >= UNSTAKE_TIMES_LIMIT) revert UnstakeTimesExceedLimit();

        uint256 tokenAmount = (_lsdTokenAmount * rate) / EIGHTEEN_DECIMALS;

        // update pool
        PoolInfo storage poolInfo = poolInfoOf[_poolAddress];
        poolInfo.unbond += tokenAmount;
        poolInfo.active -= tokenAmount;

        // burn lsdToken
        ERC20Burnable(lsdToken).burnFrom(msg.sender, _lsdTokenAmount);

        // unstake info
        uint256 willUseUnstakeIndex = nextUnstakeIndex;
        nextUnstakeIndex = willUseUnstakeIndex + 1;

        unstakeAtIndex[willUseUnstakeIndex] =
            UnstakeInfo({era: currentEra(), pool: _poolAddress, receiver: msg.sender, amount: tokenAmount});
        unstakesOfUser[msg.sender].add(willUseUnstakeIndex);

        emit Unstake(msg.sender, _poolAddress, tokenAmount, _lsdTokenAmount, willUseUnstakeIndex);
    }

    function withdrawWithPool(address _poolAddress) public {
        uint256 totalWithdrawAmount;
        uint256[] memory unstakeIndexList = getUnstakeIndexListOf(msg.sender);
        uint256 length = unstakesOfUser[msg.sender].length();
        int256[] memory emitUnstakeIndexList = new int256[](length);

        uint256 curEra = currentEra();
        for (uint256 i = 0; i < length; ++i) {
            uint256 unstakeIndex = unstakeIndexList[i];
            UnstakeInfo memory unstakeInfo = unstakeAtIndex[unstakeIndex];
            if (unstakeInfo.era + unbondingDuration > curEra || unstakeInfo.pool != _poolAddress) {
                emitUnstakeIndexList[i] = -1;
                continue;
            }

            if (!unstakesOfUser[msg.sender].remove(unstakeIndex)) revert AlreadyWithdrawed();

            totalWithdrawAmount = totalWithdrawAmount + unstakeInfo.amount;
            emitUnstakeIndexList[i] = int256(unstakeIndex);
        }

        if (totalWithdrawAmount <= 0) revert ZeroWithdrawAmount();
        IStakePool(_poolAddress).withdrawForStaker(msg.sender, totalWithdrawAmount);

        emit Withdraw(msg.sender, _poolAddress, totalWithdrawAmount, emitUnstakeIndexList);
    }

    // ----- permissionless

    function newEra() external {
        uint256 _era = latestEra + 1;
        if (currentEra() < _era) revert EraNotMatch();

        // update era
        latestEra = _era;

        uint256 totalNewReward;
        uint256 newTotalActive;
        address[] memory poolList = getBondedPools();
        for (uint256 i = 0; i < poolList.length; ++i) {
            address poolAddress = poolList[i];

            address[] memory validators = getValidatorsOf(poolAddress);

            // update validators
            IStakePool(poolAddress).updateValidators(validators);

            // bond or unbond
            PoolInfo memory poolInfo = poolInfoOf[poolAddress];
            if (poolInfo.bond > poolInfo.unbond) {
                uint256 needDelegate = poolInfo.bond - poolInfo.unbond;
                IStakePool(poolAddress).delegateMulti(validators, needDelegate);

                emit Delegate(poolAddress, validators, needDelegate);
            } else if (poolInfo.bond < poolInfo.unbond) {
                uint256 needUndelegate = poolInfo.unbond - poolInfo.bond;

                // During validator migration, pendingMigration represents ETH already unbonding
                // from the old validator. User unstakes can be satisfied from those in-transit funds
                // rather than triggering a fresh undelegateMulti (which would fail if new validator
                // has little delegation yet).
                uint256 pending = pendingMigration[poolAddress];
                if (pending >= needUndelegate) {
                    pendingMigration[poolAddress] = pending - needUndelegate;
                } else {
                    uint256 actualUndelegate = needUndelegate - pending;
                    pendingMigration[poolAddress] = 0;
                    IStakePool(poolAddress).undelegateMulti(validators, actualUndelegate);
                    emit Undelegate(poolAddress, validators, actualUndelegate);
                }
            }

            // cal total active — include in-transit migration funds so rate stays stable
            uint256 newPoolActive =
                IStakePool(poolAddress).getTotalDelegated(validators) + pendingMigration[poolAddress];
            newTotalActive = newTotalActive + newPoolActive;

            // cal reward
            uint256 poolNewReward = newPoolActive > poolInfo.active ? newPoolActive - poolInfo.active : 0;
            emit NewReward(poolAddress, poolNewReward);
            totalNewReward = totalNewReward + poolNewReward;

            // update pool state
            poolInfo.era = latestEra;
            poolInfo.active = newPoolActive;
            poolInfo.bond = 0;
            poolInfo.unbond = 0;

            poolInfoOf[poolAddress] = poolInfo;
        }

        // ditribute protocol fee
        _distributeReward(totalNewReward, rate);

        // update rate
        uint256 newRate = _calRate(newTotalActive, ERC20(lsdToken).totalSupply());
        _setEraRate(_era, newRate);

        emit ExecuteNewEra(_era, newRate);
    }
}
