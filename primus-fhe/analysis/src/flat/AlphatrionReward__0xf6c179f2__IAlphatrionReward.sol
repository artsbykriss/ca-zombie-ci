pragma solidity ^0.8.24;

/**
 * @title Interface for Alphatrion Reward Distribution
 * @notice Handles reward distribution to Alphatrions for computation work
 */
interface IAlphatrionReward {
    /**
     * @notice Emitted when computation rewards are distributed to Alphatrions.
     * @param jobId Unique identifier for the computation job.
     * @param participants List of Alphatrion addresses that participated in computation.
     * @param rewards Individual reward amounts for each participant.
     */
    event ComputationRewardDistributed(
        bytes32 indexed jobId,
        address[] participants,
        uint256[] rewards
    );

    /**
    * @notice Emitted when reward split configuration is updated
    * @param computationShare Percentage for computation participants (basis points)
    * @param callerIncentive Percentage for transaction caller (basis points)
    * @param protocolReserve Percentage for protocol reserve (basis points)
    */
    event RewardSplitUpdated(
        uint256 computationShare,
        uint256 callerIncentive,
        uint256 protocolReserve
    );

    
    /**
     * @notice Emitted when the protocol fee recipient is updated.
     * @param protocolFeeRecipient The new protocol fee recipient that receives protocol reserve rewards.
     */
    event ProtocolFeeRecipientUpdated(address indexed protocolFeeRecipient);

    /**
     * @notice Error emitted when the reward distribution fails.
     * @param reason Reason for the failure.
     */
    error RewardDistributionFailed(string reason);

     /**
     * @notice Error when split ratios don't sum to 100%
     */
    error InvalidSplitRatio(string reason);

    /**
     * @notice Distributes computation rewards to participating Alphatrions.
     * @dev Splits each rewarded handle's reward into computation, caller-incentive
     *      and protocol-reserve legs according to the current reward split
     *      configuration, then transfers `rewardToken` from `rewardPayer` to the
     *      recipients via the settlement contract.
     *      Distribution is all-or-nothing per jobId: if any rewarded handle has
     *      not reached consensus or fails the fee-ledger checks, the whole call
     *      reverts and nothing is marked distributed.
     *      Only callable by registered Alphatrion transaction senders.
     * @param jobId Unique identifier for the computation job(eg:transaction id).
     * @param rewardPayer Address whose tokens will be transferred.
     * @param rewardToken ERC20 token used for reward distribution.
     * @param ctHandles The ciphertext handles generated by FHE computations for this jobId.
     * @param rewards Individual reward amounts for each participant.
     */
    function distributeComputationReward(
        bytes32 jobId,
        address rewardPayer,
        address rewardToken,
        bytes32[] calldata ctHandles,
        uint256[] calldata rewards
    ) external;

    /**
     * @notice Checks if a job has been distributed.
     * @param jobId Unique identifier for the computation job.
     * @return isDistributed True if the job has been distributed, false otherwise.
     */
    function isJobDistributed(bytes32 jobId) external view returns (bool isDistributed);

    /**
     * @notice Gets the total distributed rewards for an Alphatrion.
     * @param alphatrionAddress Address of the Alphatrion.
     * @return amount Total amount of rewards distributed.
     */
    function getTotalDistributedRewards(address alphatrionAddress) external view returns (uint256 amount);

    /**
     * @notice Updates reward split configuration
     * @dev All percentages must sum to 10000 (100%)
     * @param _computationShare New percentage for computation participants (basis points)
     * @param _callerIncentive New percentage for caller incentive (basis points)
     * @param _protocolReserve New percentage for protocol reserve (basis points)
     */
    function updateRewardSplit(
        uint256 _computationShare,
        uint256 _callerIncentive,
        uint256 _protocolReserve
    ) external;

    /**
     * @notice Updates the protocol fee recipient that receives protocol reserve rewards.
     * @dev Only callable by SpaceBridge owner.
     * @param _protocolFeeRecipient The new protocol fee recipient.
     */
    function setProtocolFeeRecipient(address _protocolFeeRecipient) external;

    /**
     * @notice Returns the current protocol fee recipient that receives protocol reserve rewards.
     * @return The current protocol fee recipient.
     */
    function getProtocolFeeRecipient() external view returns (address);

    /**
     * @notice Returns the versions of the AlphatrionReward contract in SemVer format.
     */
    function getVersion() external pure returns (string memory);
}
