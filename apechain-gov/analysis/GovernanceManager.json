s","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"paused","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"referralManager","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"gameId","type":"uint256"}],"name":"registerGameId","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"gameId","type":"uint256"}],"name":"removeGameId","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"addr","type":"address"},{"internalType":"bool","name":"canPlay","type":"bool"}],"name":"setCanPlayForOthers","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newClaimManager","type":"address"}],"name":"setClaimManager","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newReceiver","type":"address"}],"name":"setFeeReceiver","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"house_","type":"address"}],"name":"setHouse","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"admin","type":"address"},{"internalType":"bool","name":"isAdmin_","type":"bool"}],"name":"setIsAdmin","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"game","type":"address"},{"internalType":"bool","name":"isGame_","type":"bool"}],"name":"setIsGame","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"bool","name":"_paused","type":"bool"}],"name":"setPaused","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newRNG","type":"address"}],"name":"setRNG","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newManager","type":"address"}],"name":"setReferralManager","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newTracker","type":"address"}],"name":"setUserInfoTracker","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"userInfoTracker","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"}],"conflicting_implementations":null,"certified":false,"additional_sources":[],"is_verified_via_sourcify":false,"can_be_visualized_via_sol2uml":true,"evm_version":"paris","language":"solidity","is_verified_via_eth_bytecode_db":true,"is_fully_verified":false,"license_type":"none","is_blueprint":false,"name":"GovernanceManager","creation_bytecode":"","external_libraries":[],"proxy_type":null,"implementations":[],"verified_at":"2026-10-16T01:59:43.692298Z","is_verified_via_verifier_alliance":true,"compiler_version":"0.8.28+commit.7893614a","decoded_constructor_args":[["0x48f704F490d19AE7E46d5EA92f2f31Df3B9381E4",{"internalType":"address","name":"owner_","type":"address"}]],"sourcify_repo_url":null,"optimization_runs":200,"compiler_settings":{"evmVersion":"paris","libraries":{},"optimizer":{"enabled":true,"runs":200}},"github_repository_metadata":null,"is_verified":true,"verified_twin_address_hash":null,"optimization_enabled":true,"deployed_bytecode":"","source_code":"//SPDX-License-Identifier: MIT\r\npragma solidity 0.8.28;\r\n\r\ncontract GovernanceManager {\r\n\r\n    /** Master Of Protocol */\r\n    address private _owner;\r\n\r\n    // Is A Game Contract\r\n    mapping ( address => bool ) private _isGame;\r\n\r\n    // Is a contract that can play games on behalf of others\r\n    mapping ( address => bool ) private _canPlayForOthers;\r\n\r\n    // Is an admin that can call certain functions\r\n    mapping ( address => bool ) private _isAdmin;\r\n\r\n    // User Info Tracker\r\n    address public userInfoTracker;\r\n\r\n    // House Contract For PvH Games\r\n    address public house;\r\n\r\n    // Referral Contract\r\n    address public referralManager;\r\n\r\n    // Fee Manager\r\n    address public feeReceiver;\r\n\r\n    // Claim Manager Contract\r\n    address public claimManager;\r\n\r\n    // RNG Contract\r\n    address public RNG;\r\n\r\n    // Global Pause\r\n    bool public paused;\r\n\r\n    // Globally Tracked Game IDs -- mostly for front end viewing\r\n    uint256[] public allGameIds;\r\n\r\n    // onlyOwner modifier\r\n    modifier onlyOwner() {\r\n        require(msg.sender == _owner, 'Only Owner');\r\n        _;\r\n    }\r\n\r\n    constructor(\r\n        address owner_\r\n    ) {\r\n        // set ownership\r\n        _owner = owner_;\r\n    }\r\n\r\n    function registerGameId(uint256 gameId) external onlyOwner {\r\n        allGameIds.push(gameId);\r\n    }\r\n\r\n    function removeGameId(uint256 gameId) external onlyOwner {\r\n        uint256 length = allGameIds.length;\r\n        uint index = length;\r\n        for (uint256 i = 0; i < length; i++) {\r\n            if (allGameIds[i] == gameId) {\r\n                index = i;\r\n                break;\r\n            }\r\n        }\r\n        require(index < length, 'Game ID Not Found');\r\n        allGameIds[index] = allGameIds[length - 1];\r\n        allGameIds.pop();\r\n    }\r\n\r\n    function setFeeReceiver(address newReceiver) external onlyOwner {\r\n        feeReceiver = newReceiver;\r\n    }\r\n\r\n    function setClaimManager(address newClaimManager) external onlyOwner {\r\n        require(newClaimManager != address(0), 'Zero Address');\r\n        claimManager = newClaimManager;\r\n    }\r\n\r\n    function setCanPlayForOthers(address addr, bool canPlay) external onlyOwner {\r\n        _canPlayForOthers[addr] = canPlay;\r\n    }\r\n\r\n    function setRNG(address newRNG) external onlyOwner {\r\n        RNG = newRNG;\r\n    }\r\n\r\n    function setPaused(bool _paused) external onlyOwner {\r\n        paused = _paused;\r\n    }\r\n\r\n    function setHouse(address house_) external onlyOwner {\r\n        require(\r\n            house_ != address(0),\r\n            'Zero House'\r\n        );\r\n        house = house_;\r\n    }\r\n\r\n    function changeOwner(address newOwner) external onlyOwner {\r\n        _owner = newOwner;\r\n    }\r\n\r\n    function setIsGame(address game, bool isGame_) external onlyOwner {\r\n        _isGame[game] = isGame_;\r\n    }\r\n\r\n    function setIsAdmin(address admin, bool isAdmin_) external onlyOwner {\r\n        _isAdmin[admin] = isAdmin_;\r\n    }\r\n\r\n    function setReferralManager(address newManager) external onlyOwner {\r\n        referralManager = newManager;\r\n    }\r\n\r\n    function setUserInfoTracker(address newTracker) external onlyOwner {\r\n        userInfoTracker = newTracker;\r\n    }\r\n\r\n    function getOwner() external view returns (address) {\r\n        return _owner;\r\n    }\r\n\r\n    function owner() external view returns (address) {\r\n        return _owner;\r\n    }\r\n\r\n    function isGame(address game) external view returns (bool) {\r\n        return _isGame[game];\r\n    }\r\n\r\n    function isAdmin(address admin) external view returns (bool) {\r\n        return _isAdmin[admin] || _owner == admin;\r\n    }\r\n\r\n    function canPlayForOthers(address addr) external view returns (bool) {\r\n        return _canPlayForOthers[addr] || addr == claimManager;\r\n    }\r\n\r\n}","creation_status":"success","file_path":"GovernanceManager.sol"}