	pool_last_updated_sec: u64,
	unobtainable_reward: u128,
	earned_reward: u128,
	unlock_time: u64
}

struct UnstakeEvent has copy, drop, store {
	pool_id: address,
	user_address: address,
	amount: u64,
	user_staked_amount: u64,
	accum_reward: u128,
	total_staked: u64,
