module CBTC.Credentials where

import Utility.Credential.V0.Credential (PartyCredentialRequirement(..))

-- | Get credential requirements for CBTC operations (account creation, deposit, withdraw).
-- The registrar (DEC party) must have issued a credential with the Minter role.
getCBTCOperationRequirements : Party -> [PartyCredentialRequirement]
getCBTCOperationRequirements registrar =
  [ PartyCredentialRequirement with
      issuer = registrar
      requiredClaims = [("hasCBTCRole", "Minter")]
  ]
