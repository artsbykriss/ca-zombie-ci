module CBTC.DepositAccount where

import DA.Optional
import DA.List(head)
import Splice.Util
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.BurnMintV1
import Splice.Api.Token.MetadataV1

import Utility.Credential.V0.Credential (Credential, assertFulfillsAllRequirements)
import CBTC.Credentials (getCBTCOperationRequirements)

import Common.Common

depositAccountId : (ContractId CBTCDepositAccount, CBTCDepositAccount) -> ContractId CBTCDepositAccount
depositAccountId (self, this) = fromOptional self this.id

template CBTCDepositAccount
  with
    registrar : Party
      -- ^ The decentralized registrar party
    operator : Party
      -- ^ The operator of the utility
    instrument : InstrumentId
      -- ^ The instrument identifier
    owner : Party
      -- ^ The owner of the DepositAccount.
    id : Optional (ContractId CBTCDepositAccount)
      -- ^ Unique identifier of the CBTCDepositAccount. If this is None
      -- it's the contract id of the contract itself.
      -- Note that this only serves as a unique identifier. The contract
      -- it references may already have been consumed.
      -- ^ This is used by the Attestors to create a unique BTC Deposit Address for the user.
    lastProcessedBitcoinBlock: Int
      -- ^ The last processed Bitcoin block for this account.
    limits : Optional Limits
      -- ^ Transaction limits for this account. None = no limits enforced.
  where
    signatory registrar, owner

    choice CBTCDepositAccount_CompleteDeposit : CBTCDepositAccount_CompleteDepositResult
      with
        amount: Decimal
          -- ^ The amount of BTC deposited.
        bitcoinBlock: Int
          -- ^ The last processed Bitcoin block for this account.
          -- This is the block at which the deposit was confirmed.
        burnMintFactoryCid : Optional (ContractId BurnMintFactory)
          -- ^ Factory for token standard support
        extraArgs : Optional ExtraArgs
          -- ^ Extra args to pass to the BurnMint choice
        credentialCids : Optional [ContractId Credential]
          -- ^ Credentials proving the owner has the Minter role.
      controller registrar
      do
        let cids = fromSomeNote "Credential CIDs required" credentialCids
        credentials <- mapA fetch cids
        assertFulfillsAllRequirements owner (getCBTCOperationRequirements registrar) credentials
        require "amount must be positive" (amount > 0.0)
        checkLimits "Deposit" amount this.limits
        require "Last processed Bitcoin block must be greater than the current block height" (bitcoinBlock > this.lastProcessedBitcoinBlock)

        -- Update the last processed Bitcoin block
        depositAccountCid <- create this with
          lastProcessedBitcoinBlock = bitcoinBlock
          id = Some (fromOptional self this.id)

        let factoryCid = fromSomeNote "burnMintFactoryCid must be set" burnMintFactoryCid

        result <- exercise factoryCid BurnMintFactory_BurnMint with
          expectedAdmin = registrar
          instrumentId = instrument
          inputHoldingCids = []
          outputs = [BurnMintOutput with
            owner = owner
            amount = amount
            context = emptyChoiceContext]
          extraActors = [owner]
          extraArgs = fromSomeNote "extraArgs must be set" extraArgs
        pure CBTCDepositAccount_CompleteDepositResult with
          depositAccountCid
          mintedHoldingCid = head result.outputCids
          mintedHoldings = Some(result.outputCids)

    choice CBTCDepositAccount_UpdateLimits : CBTCDepositAccount_UpdateLimitsResult
      with
        newLimits : Limits
      controller registrar
      do
        let normalized = normalizeLimits newLimits
        require "New limits must differ from current limits" (normalized /= this.limits)
        require "Limits must be well-formed" (validateLimits newLimits)
        accountCid <- create this with
          limits = normalized
          id = Some (fromOptional self this.id)
        pure CBTCDepositAccount_UpdateLimitsResult with depositAccountCid = accountCid, limits = normalized

    choice CBTCDepositAccount_CloseUserAccount : CBTCDepositAccount_CloseAccountResult
      controller registrar
      do
        return CBTCDepositAccount_CloseAccountResult

data CBTCDepositAccount_CompleteDepositResult = CBTCDepositAccount_CompleteDepositResult
  with
    depositAccountCid: ContractId CBTCDepositAccount
      -- ^ The contract ID of the updated CBTCDepositAccount.
    mintedHoldingCid: ContractId Holding
      -- ^ The contract ID of the minted Holding. Deprecated, use mintedHoldings instead.
    mintedHoldings: Optional [ContractId Holding]
      -- ^ The contract IDs of all minted Holdings.
  deriving (Eq, Show)

data CBTCDepositAccount_UpdateLimitsResult = CBTCDepositAccount_UpdateLimitsResult
  with
    depositAccountCid : ContractId CBTCDepositAccount
    limits : Optional Limits
  deriving (Eq, Show)

data CBTCDepositAccount_CloseAccountResult = CBTCDepositAccount_CloseAccountResult

template CBTCDepositAccountRules with
    registrar : Party
      -- ^ The decentralized registrar party
    operator : Party
      -- ^ The operator of the utility
    instrument : InstrumentId
      -- ^ The instrument identifier
    limits : Optional Limits
      -- ^ Default limits for newly created deposit accounts. None = no limits.
  where
    signatory registrar

    choice CBTCDepositAccountRules_UpdateLimits : CBTCDepositAccountRules_UpdateLimitsResult
      with
        newLimits : Limits
      controller registrar
      do
        let normalized = normalizeLimits newLimits
        require "New limits must differ from current limits" (normalized /= this.limits)
        require "Limits must be well-formed" (validateLimits newLimits)
        rulesCid <- create this with limits = normalized
        pure CBTCDepositAccountRules_UpdateLimitsResult with depositAccountRulesCid = rulesCid, limits = normalized

    nonconsuming choice CBTCDepositAccountRules_CreateDepositAccount : CBTCAccountRules_CreateDepositAccountResult
      with
        owner: Party
          -- ^ The owner of the DepositAccount.
        credentialCids : Optional [ContractId Credential]
          -- ^ Credentials proving the owner meets the requirements.
      controller owner
      do
        let cids = fromSomeNote "Credential CIDs required" credentialCids
        credentials <- mapA fetch cids
        assertFulfillsAllRequirements owner (getCBTCOperationRequirements registrar) credentials
        accountCid <- create CBTCDepositAccount with
          registrar
          operator
          instrument
          owner
          id = None
          lastProcessedBitcoinBlock = 0
          limits = this.limits
        pure CBTCAccountRules_CreateDepositAccountResult with
          depositAccountCid = accountCid

data CBTCAccountRules_CreateDepositAccountResult = CBTCAccountRules_CreateDepositAccountResult
  with
    depositAccountCid: ContractId CBTCDepositAccount
      -- ^ The contract ID of the created CBTCDepositAccount.
  deriving (Eq, Show)

data CBTCDepositAccountRules_UpdateLimitsResult = CBTCDepositAccountRules_UpdateLimitsResult
  with
    depositAccountRulesCid : ContractId CBTCDepositAccountRules
    limits : Optional Limits
  deriving (Eq, Show)

instance HasCheckedFetch CBTCDepositAccount ForHolding where
  contractGroupId CBTCDepositAccount{..} = ForHolding with
    operator, registrar, instrumentId = instrument

instance HasCheckedFetch CBTCDepositAccountRules ForHolding where
  contractGroupId CBTCDepositAccountRules{..} = ForHolding with
    operator, registrar, instrumentId = instrument
