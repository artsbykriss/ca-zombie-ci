g":"withdraw-margined-managed-osmo-lst-and-eth-btc-liquidity","posts_count":1,"reply_count":0,"highest_post_number":1,"image_url":null,"created_at":"2026-09-30T08:50:01.364Z","last_posted_at":"2026-09-30T08:50:01.410Z","bumped":true,"bumped_at":"2026-09-30T08:50:01.410Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"tags":[],"tags_descriptions":{},"like_count":1,"views":221,"category_id":5,"featured_link":null,"op_like_count":1,"has_accepted_answer":false,"posters":[{"extras":"latest single","description":"Original Poster, Most Recent Poster","user":{"id":2,"username":"JohnnyWyles","name":"Johnny Wyles","avatar_template":"/user_avatar/forum.osmosis.zone/johnnywyles/{size}/3114_2.png","admin":true,"trust_level":4}}]},{"fancy_title":"Withdraw qOSMO Liquidity for redemption","id":4058,"title":"Withdraw qOSMO Liquidity for redemption","slug":"withdraw-qosmo-liquidity-for-redemption","posts_count":1,"reply_count":0,"highest_post_number":1,"image_url":null,"created_at":"2026-07-01T16:23:16.556Z","last_posted_at":"2026-07-01T16:23:16.635Z","bumped":true,"bumped_at":"2026-07-01T16:23:16.635Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"tags":[],"tags_descriptions":{},"like_count":0,"views":46,"category_id":5,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":"latest single","description":"Original Poster, Most Recent Poster","user":{"id":2,"username":"JohnnyWyles","name":"Johnny Wyles","avatar_template":"/user_avatar/forum.osmosis.zone/johnnywyles/{size}/3114_2.png","admin":true,"trust_level":4}}]},{"fancy_title":"Remove the stOSMO liquidity","id":2929,"title":"Remove the stOSMO liquidity","slug":"remove-the-stosmo-liquidity","posts_count":2,"reply_count":0,"highest_post_number":2,"image_url":null,"created_at":"2024-07-13T16:14:48.005Z",