{"has_methods_read":true,"is_self_destructed":false,"has_custom_methods_write":false,"file_path":"contracts/WBOT.sol","source_code":"// SPDX-License-Identifier: MIT\npragma solidity ^0.7.6;\n\n/**\n * @title WBOT.sol - Wrapped BOT\n * @notice 将原生 BOT 包装成 ERC-20 标准代币的合约\n * @dev 这是以太坊上最广泛使用的 WBOT 实现，与 Uniswap 等 DeFi 协议兼容\n *\n * 主要功能：\n * - 用户可以将 BOT 存入合约，获得等量的 WBOT 代币\n * - WBOT 可以在 DeFi 协议中作为 ERC-20 代币使用\n * - 用户可以销毁 WBOT 代币，取回等量的 BOT\n * - 支持标准的 ERC-20 转账和授权功能\n */\ncontract WBOT {\n    // ERC-20 代币基本信息\n    string public name = \"Wrapped BOT\"; // 代币名称\n    string public symbol = \"WBOT\"; // 代币符号\n    uint8 public decimals = 18; // 精度（与 BOT 相同）\n\n    // 事件定义\n    event Approval(address indexed src, address indexed guy, uint wad); // 授权事件\n    event Transfer(address indexed src, address indexed dst, uint wad); // 转账事件\n    event Deposit(address indexed dst, uint wad); // 存款事件\n    event Withdrawal(address indexed src, uint wad); // 取款事件\n\n    // 状态变量\n    mapping(address => uint) public balanceOf; // 账户余额\n    mapping(address => mapping(address => uint)) public allowance; // 授权额度\n\n    /**\n     * @notice 接收 BOT 的默认函数\n     * @dev 当合约收到 BOT 时自动调用 deposit() 函数\n     */\n    receive() external payable {\n        deposit();\n    }\n\n    /**\n     * @notice 存入 BOT 获得 WBOT\n     * @dev 用户发送 BOT 到合约，合约铸造等量的 WBOT 给用户\n     */\n    function deposit() public payable {\n        balanceOf[msg.sender] += msg.value; // 增加用户 WBOT 余额\n        emit Deposit(msg.sender, msg.value); // 触发存款事件\n    }\n\n    /**\n     * @notice 销毁 WBOT 取回 BOT\n     * @param wad 要销毁的 WBOT 数量\n     * @dev 用户销毁 WBOT 代币，合约发送等量的 BOT 给用户\n     */\n    function withdraw(uint wad) public {\n        require(balanceOf[msg.sender] >= wad, \"Insufficient WBOT balance\"); // 检查余额\n        balanceOf[msg.sender] -= wad; // 减少用户 WBOT 余额\n        msg.sender.transfer(wad); // 发送 BOT 给用户\n        emit Withdrawal(msg.sender, wad); // 触发取款事件\n    }\n\n    /**\n     * @notice 获取 WBOT 总供应量\n     * @return 合约中的 BOT 余额（等于 WBOT 总供应量）\n     * @dev WBOT 总供应量等于合约持有的 BOT 数量\n     */\n    function totalSupply() public view returns (uint) {\n        return address(this).balance;\n    }\n\n    /**\n     * @notice 授权其他地址使用自己的 WBOT\n     * @param guy 被授权的地址\n     * @param wad 授权数量\n     * @return 是否成功\n     * @dev 标准 ERC-20 授权功能\n     */\n    function approve(address guy, uint wad) public returns (bool) {\n        allowance[msg.sender][guy] = wad; // 设置授权额度\n        emit Approval(msg.sender, guy, wad); // 触发授权事件\n        return true;\n    }\n\n    /**\n     * @notice 转账 WBOT\n     * @param dst 接收地址\n     * @param wad 转账数量\n     * @return 是否成功\n     * @dev 标准 ERC-20 转账功能，内部调用 transferFrom\n     */\n    function transfer(address dst, uint wad) public returns (bool) {\n        return transferFrom(msg.sender, dst, wad);\n    }\n\n    /**\n     * @notice 从指定地址转账 WBOT\n     * @param src 发送地址\n     * @param dst 接收地址\n     * @param wad 转账数量\n     * @return 是否成功\n     * @dev 标准 ERC-20 转账功能，支持授权转账\n     */\n    function transferFrom(\n        address src,\n        address dst,\n        uint wad\n    ) public returns (bool) {\n        require(balanceOf[src] >= wad, \"Insufficient balance\"); // 检查发送方余额\n\n        // 如果不是发送方本人操作，需要检查授权\n        if (src != msg.sender && allowance[src][msg.sender] != uint(-1)) {\n            require(\n                allowance[src][msg.sender] >= wad,\n                \"Insufficient allowance\"\n            ); // 检查授权额度\n            allowance[src][msg.sender] -= wad; // 减少授权额度\n        }\n\n        // 执行转账\n        balanceOf[src] -= wad; // 减少发送方余额\n        balanceOf[dst] += wad; // 增加接收方余额\n\n        emit Transfer(src, dst, wad); // 触发转账事件\n\n        return true;\n    }\n}\n","deployed_bytecode":"","optimization_enabled":true,"verified_twin_address_hash":"0x791Baa367AC3f1fb2050c1D8D591A0Fae3529AA4","is_verified":true,"compiler_settings":{"libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":1000000},"outputSelection":{"*":{"":["*"],"*":["*"]}}},"optimization_runs":1000000,"sourcify_repo_url":null,"decoded_constructor_args":null,"has_methods_write":true,"compiler_version":"v0.7.6+commit.7338295f","is_verified_via_verifier_alliance":false,"verified_at":"2026-02-26T06:08:52.291509Z","implementations":[],"proxy_type":null,"external_libraries":[],"creation_bytecode":"","name":"WBOT","is_blueprint":false,"license_type":"none","is_fully_verified":false,"has_methods_read_proxy":false,"is_vyper_contract":false,"is_verified_via_eth_bytecode_db":true,"language":"solidity","evm_version":"default","can_be_visualized_via_sol2uml":false,"has_methods_write_proxy":false,"has_custom_methods_read":false,"is_verified_via_sourcify":false,"additional_sources":[],"certified":false,"abi":[{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"src","type":"address"},{"indexed":true,"internalType":"address","name":"guy","type":"address"},{"indexed":false,"internalType":"uint256","name":"wad","type":"uint256"}],"name":"Approval","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"dst","type":"address"},{"indexed":false,"internalType":"uint256","name":"wad","type":"uint256"}],"name":"Deposit","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"src","type":"address"},{"indexed":true,"internalType":"address","name":"dst","type":"address"},{"indexed":false,"internalType":"uint256","name":"wad","type":"uint256"}],"name":"Transfer","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"src","type":"address"},{"indexed":false,"internalType":"uint256","name":"wad","type":"uint256"}],"name":"Withdrawal","type":"event"},{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"address","name":"","type":"address"}],"name":"allowance","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"guy","type":"address"},{"internalType":"uint256","name":"wad","type":"uint256"}],"name":"approve","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"balanceOf","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"decimals","outputs":[{"internalType":"uint8","name":"","type":"uint8"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"deposit","outputs":[],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"name","outputs":[{"internalType":"string","name":"","type":"string"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"symbol","outputs":[{"internalType":"string","name":"","type":"string"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"totalSupply","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"dst","type":"address"},{"internalType":"uint256","name":"wad","type":"uint256"}],"name":"transfer","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"src","type":"address"},{"internalType":"address","name":"dst","type":"address"},{"internalType":"uint256","name":"wad","type":"uint256"}],"name":"transferFrom","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"wad","type":"uint256"}],"name":"withdraw","outputs":[],"stateMutability":"nonpayable","type":"function"},{"stateMutability":"payable","type":"receive"}],"is_changed_bytecode":false,"is_partially_verified":true,"constructor_args":null}